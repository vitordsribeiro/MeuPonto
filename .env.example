# Copie este arquivo para .env (uso local, opcional) e preencha os valores.
# No Vercel, essas mesmas variáveis são configuradas no dashboard do projeto,
# em Settings > Environment Variables — não em um arquivo.

SECRET_KEY=troque-por-uma-chave-aleatoria-longa
SHEET_ID=o-id-da-sua-planilha
GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}
